# Rust
/target/

# Local build logs (run.sh output)
/build/

# Internal perf decomposition / research docs — local-only.  Phase A
# read-only ground-truth that informs Phase B attacks; not meant to
# travel through main-branch history.
/.dev/

# Reference open-source projects and specs — local-only, not committed.
# Pinned versions tracked in references/README.md.
/references/*
!/references/README.md

# Update-signing PRIVATE key — never commit.  The public half
# (keys/marspot-update.pub) IS committed and embedded in the updater.
/keys/marspot-update.sec

# macOS
.DS_Store
*.swp
bench/scenarios/
bench/results/
bench/remote-runs/

# Per-session handoff snapshot (managed by /handoff skill, not source).
.claude/handoff.md

# Per-user Claude Code permission profile — not source.
.claude/settings.json

# Local credentials — never committed.
.env.local
